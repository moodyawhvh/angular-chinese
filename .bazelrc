# ============================================================
# 中文注释(angular-chinese 翻译项目):
# 本文件是 Angular 仓库的 Bazel 构建配置(.bazelrc)。
# 以下所有命令行标志(flag)均保持原样,仅将注释翻译为中文;
# 标志行的含义决定了构建行为,请勿随意修改。
# ============================================================

# 关闭 NG CLI 的 TTY(终端交互)模式
build --action_env=NG_FORCE_TTY=false

# 通过 --config=debug 启用调试测试
test:debug --test_arg=--node_options=--inspect-brk --test_output=streamed --test_strategy=exclusive --test_timeout=9999 --nocache_test_results --strategy=TestRunner=standalone

# 本地不做去抖(deflake)重试。
# 在 CI 上可能将其设为 `3`,以启用去抖重试。
test --flaky_test_attempts=1

# `rules_ts` 所必需。
common --@aspect_rules_ts//ts:skipLibCheck=always
common --@aspect_rules_ts//ts:default_to_tsc_transpiler

# 若不设置此项,TS 动作的 `env` 会被忽略。
common --incompatible_merge_fixed_and_default_shell_env

# 锁定锁文件(不允许更新)
common --lockfile_mode=error

###############################
# 文件系统交互                 #
###############################

# 在项目内创建符号链接:
# - 输出位于 dist/bin
# - 测试日志与生成文件位于 dist/testlogs、dist/genfiles
# - 以及 bazel-out
# 注意:编辑器配置应排除 bazel-out 目录。
# 仓库中已提交的 /.vscode/settings.json 已为 VSCode 做好此配置。
# 其他编辑器可能需要手动配置以忽略该目录。
# 过去曾出现过 VSCode 遍历巨型目录树、不断打开文件句柄,
# 最终在 MacOS High Sierra 上自动探测 C++ 工具链时意外失败的问题。
# 参见 https://github.com/bazelbuild/bazel/issues/4603
build --symlink_prefix=dist/

# 关闭旧式 external runfiles
build --nolegacy_external_runfiles
run --nolegacy_external_runfiles
test --nolegacy_external_runfiles

# 开启 --incompatible_strict_action_env。该选项在 Bazel 0.21.0 中曾默认开启,
# 0.22.0 中又被关闭。详情关注
# https://github.com/bazelbuild/bazel/issues/7026 。
# 需要此标志,是为了保证通过 `pnpm bazel` 运行时
# bazel 缓存不会失效。
# 参见 https://github.com/angular/angular/issues/27514 。
build --incompatible_strict_action_env
run --incompatible_strict_action_env
test --incompatible_strict_action_env

# 默认不构建 runfile 树。如果某个执行策略依赖 runfile 符号链接树,
# 该树会按需创建。参见:https://github.com/bazelbuild/bazel/issues/6627
# 以及 https://github.com/bazelbuild/bazel/commit/03246077f948f2790a83520e7dccc2625650e6df
build --nobuild_runfile_links

build --enable_runfiles

###############################
# 发布支持                     #
# 通过 --config=release 启用   #
# 以下设置                     #
###############################

# 发布构建必须打上版本控制信息戳
# 该命令假定 node 在 PATH 中,是对下面问题的规避方案:
# https://github.com/bazelbuild/bazel/issues/4802
build:release --workspace_status_command="pnpm --silent ng-dev release build-env-stamp --mode=release"
build:release --stamp

# 快照构建同样要打上版本控制信息戳。
build:snapshot-build --workspace_status_command="pnpm --silent ng-dev release build-env-stamp --mode=snapshot"
build:snapshot-build --stamp
# @angular/language-server 包直接依赖其他 Angular 框架包。
# 此标志确保 language server 使用仓库内快照构建的框架包。
build:snapshot-build --//:enable_language_server_snapshot_repo_deps

# Angular DevTools 的 Firefox 版发布*不能*打戳,`--config snapshot-build-firefox` 是空操作。
# 这是因为 Mozilla 要求上传插件源码,然后由其手动复现构建。
# 如果我们基于当前提交等 Git 信息为构建打戳,那么要复现构建就得
# 上传整个 `.git` 目录。我们本来就必须上传整个 monorepo,再上传 `.git`
# 就会超出源文件大小上限。为解决此问题,我们干脆*不*为 Angular DevTools 的 Firefox 构建打戳。
build:snapshot-build-firefox --nostamp

###############################
# 输出                         #
###############################

# 为 bazel query 提供更有用的默认输出模式
# 例如输出 "ng_module rule //foo:bar",而不仅仅是 "//foo:bar"
query --output=label_kind

# 默认情况下,失败的测试不会打印任何输出,输出会进入日志文件
test --test_output=errors

##################################
# 远程构建执行支持                #
# 通过 --config=remote 启用      #
# 以下设置                       #
##################################

# 一旦 https://github.com/bazelbuild/bazel/issues/7254 被修复,
# 下面的 --define=EXECUTOR=remote 就可以移除
build:remote --define=EXECUTOR=remote

# 设置较高的超时值,以防万一。
build:remote --remote_timeout=600

# Bazel 会根据宿主机资源探测最大作业(job)数。
# 既然我们是在远程执行,就可以大幅提高这个数字。
common:remote --jobs=200

build:remote --google_default_credentials

# 强制远程执行将整个运行视为 linux 环境
build:remote --cpu=k8
build:remote --host_cpu=k8

# 工具链与平台相关标志
build:remote --extra_execution_platforms=@devinfra//bazel/remote-execution:platform_with_network
build:remote --host_platform=@devinfra//bazel/remote-execution:platform_with_network
build:remote --platforms=@devinfra//bazel/remote-execution:platform_with_network

# 远程实例与缓存
build:remote --remote_instance_name=projects/internal-200822/instances/primary_instance
build:remote --bes_instance_name=internal-200822
build:remote --remote_cache=remotebuildexecution.googleapis.com
build:remote --remote_executor=remotebuildexecution.googleapis.com
build:remote --remote_upload_local_results=false

build:remote --remote_grpc_log=/tmp/rbe-grpc.log

# 参见:https://docs.google.com/document/d/1NgDPsCIwprDdqC1zj0qQrh5KGK2hQTSTux1DAvi4rSc/edit?tab=t.0.
build:remote --experimental_remote_execution_keepalive

# 使用 HTTP 远程缓存
build:remote-cache --remote_cache=https://storage.googleapis.com/angular-team-cache
build:remote-cache --remote_accept_cached=true
build:remote-cache --remote_upload_local_results=false
build:remote-cache --google_default_credentials

# 运行拥有额外访问权限的“受信构建(trusted build)”时附加的标志
build:trusted-build --remote_upload_local_results=true

# 确保像 "no-remote-exec" 这类标签能传播到由规则创建的动作上,
# 即使规则实现没有把它们显式传入执行要求。
# https://bazel.build/reference/command-line-reference#flag--experimental_allow_tags_propagation
common --incompatible_allow_tags_propagation

# 默认在沙箱中禁用网络访问。若要为特定目标开启网络访问,使用:
#
# load("@devinfra//bazel/remote-execution:index.bzl", "ENABLE_NETWORK")
# my_target(
#   ...,
#   exec_properties = ENABLE_NETWORK,   # Enables network in remote exec
#   tags = ["requires-network"]         # Enables network in sandbox
# )
build --nosandbox_default_allow_network

################
# 标志别名      #
################

# --ng_perf 会让 Ivy 编译器为每次构建输出性能数据。
build --flag_alias=ng_perf=//packages/compiler-cli:ng_perf

####################################################
# 用户 Bazel 配置
# 注意:此处必须是配置中的*最后*一条。
####################################################

# 加载当前用户专属的设置。必须是本配置中的*最后*一条语句,
# 因为用户配置应当能够覆盖本文件中的标志。
try-import %workspace%/.bazelrc.user
